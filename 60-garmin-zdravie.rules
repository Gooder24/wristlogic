# Garmin watches over MTP for the plugdev group (a headless box has no seat for uaccess); plugging one in starts
# zdravie's import in the user's systemd.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="091e", MODE="0660", GROUP="plugdev", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="zdravie-import.service"
